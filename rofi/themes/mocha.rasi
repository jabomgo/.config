* {
    bg:             #11111bdd;
    bg-card:        #1e1e2eee;
    bg-hover:       #313244ee;
    fg:             #cdd6f4;
    muted:          #a6adc8;
    accent:         #cba6f7;
    border-color:   #cba6f766;

    background-color: transparent;
    text-color: @fg;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 600px;
    border: 1px;
    border-color: @border-color;
    border-radius: 18px;
    background-color: @bg;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @bg-card;
    border: 1px;
    border-color: #45475a;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Pesquisar aplicativos...";
    placeholder-color: @muted;
    text-color: @fg;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 7;
    spacing: 5px;
    fixed-height: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    border-radius: 10px;
    padding: 10px;
    spacing: 12px;
}

element normal {
    text-color: @fg;
}

element selected {
    background-color: @bg-hover;
    text-color: @accent;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

message {
    background-color: transparent;
    text-color: @muted;
}
